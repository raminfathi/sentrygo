# ==========================================
# SentryGo Environment Configuration Template
# ==========================================

# --- Web Dashboard Security ---
WEB_PORT=:8080
DASHBOARD_USER=admin
DASHBOARD_PASS=your_secure_password_here

# --- Camera Settings (Hikvision RTSP) ---
CAMERA_IP=192.168.1.100
CAMERA_USER=admin
CAMERA_PASS=your_camera_password

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTuvWxyz
TELEGRAM_CHAT_ID=111111111,222222222
TELEGRAM_PROXY=socks5://127.0.0.1:2080

# --- Bale Bot (Iranian Messenger) ---
BALE_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTuvWxyz
BALE_CHAT_ID=111111111

# --- FarazSMS Configuration ---
# Format: ApiKey:Phone:SenderLine,ApiKey2:Phone2:SenderLine2
SMS_ACCOUNTS=your_api_key:09123456789:90001234
SMS_PATTERN_CODE=pattern_code_for_alerts
SMS_STARTUP_PATTERN=pattern_code_for_startup
SMS_PHONES=09123456789,09198765432

# --- System Settings ---
ALERT_COOLDOWN_SECONDS=60